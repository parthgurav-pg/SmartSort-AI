# SMARTSORT AI FreeCAD Macro v2.0 - no plugin needed
"""SmartSort AI prototype v2.0 geometry in millimetres.
This is a layout/prototype CAD, not a fabrication-approved mechanical drawing.
Edit the parameters here and regenerate with the accompanying build script.
Coordinate reference: +X conveyor travel, +Y toward reject bin, +Z upward;
ground Z=0, example belt surface Z=140 mm.
"""
from dataclasses import dataclass, field

TUNNEL_L=300.0
BELT_W=150.0
BELT_Z=140.0
INNER_W=210.0
TUNNEL_CLEAR_H=200.0
WALL_T=6.0
ROOF_T=6.0
SERVO_ARM_LENGTH=150.0
SERVO_X=450.0       # servo shaft; tunnel ends at X=300, so 150mm downstream
IR_ENTRY_X=45.0     # inside inspection chamber, just after entrance curtain
IR_PRE_SORT_X=410.0 # downstream; 40mm upstream of servo shaft
BELT_EDGE_LEFT=-BELT_W/2  # -75 mm; keep all sensor hardware at Y<=-80mm

@dataclass
class Part:
    name: str
    group: str
    color: tuple
    role: str = ''
    material: str = ''
    ops: list = field(default_factory=list)
    transparency: int = 0
    def box(self, a, b, cut=False):
        self.ops.append(('cut_box' if cut else 'box',tuple(a),tuple(b)))
        return self
    def cyl(self, r, l, base, axis='z', cut=False):
        self.ops.append(('cut_cyl' if cut else 'cyl',float(r),float(l),tuple(base),axis))
        return self
    def slot(self, x1, x2, z, r, ybase, depth): # slot through y
        if abs(x2-x1)>0.001:
            self.box((min(x1,x2),ybase,z-r),(max(x1,x2),ybase+depth,z+r),True)
        self.cyl(r,depth,(x1,ybase,z),'y',True)
        self.cyl(r,depth,(x2,ybase,z),'y',True)
        return self

PARTS=[]
C = {
 'tunnel':(0.33,0.55,0.78), 'frame':(0.18,0.23,0.30),
 'bracket':(0.66,0.71,0.75), 'curtain':(0.42,0.79,0.84),
 'pcb':(0.07,0.43,0.33), 'lens':(0.11,0.14,0.18),
 'cabinet':(0.93,0.95,0.97), 'panel':(0.75,0.82,0.85),
 'elec':(0.16,0.46,0.27), 'hub':(0.23,0.29,0.37), 'buck':(0.18,0.53,0.42),
 'servo':(0.15,0.17,0.23), 'arm':(0.96,0.52,0.15),
 'belt':(0.35,0.39,0.43),'bin':(0.29,0.55,0.73),
 'foot':(0.18,0.23,0.30),'light':(0.99,0.87,0.36),
 'sample':(0.95,0.69,0.27)
}
def part(name,group,color,role='',material='',opacity=0):
    p=Part(name,group,C[color],role,material,transparency=opacity)
    PARTS.append(p)
    return p

