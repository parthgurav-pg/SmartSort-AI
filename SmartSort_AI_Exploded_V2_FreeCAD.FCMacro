# --------------------- FREECAD ASSEMBLY EXPORT -------------------------------
# Run this .FCMacro in FreeCAD: Macro > Macros > select file > Execute.
# The resulting document has separate editable Part::Feature solids, groups,
# colors, and dimensional notes. Save through the prompted dialog.
import os
import FreeCAD as App
import Part as FCPart
from FreeCAD import Vector

old=App.ActiveDocument
if old and old.Name=="SmartSort_AI_Prototype":
    App.closeDocument(old.Name)
doc=App.newDocument("SmartSort_AI_Prototype")
folders={}
for gn in GROUPS:
    gr=doc.addObject('App::DocumentObjectGroup','Group_'+gn.split(' - ')[0])
    gr.Label=gn
    folders[gn]=gr

def make_feature(s):
    shape=None
    for op in s.ops:
        typ=op[0]
        if typ in ('box','cut_box'):
            a,b=op[1:3]
            obj=FCPart.makeBox(b[0]-a[0],b[1]-a[1],b[2]-a[2],Vector(*a))
        else:
            _,r,h,base,axis=op
            obj=FCPart.makeCylinder(r,h,Vector(*base),{'x':Vector(1,0,0),'y':Vector(0,1,0),'z':Vector(0,0,1)}[axis])
        if typ.startswith('cut_'):
            if shape is not None: shape=shape.cut(obj)
        elif shape is None: shape=obj
        else: shape=shape.fuse(obj)
    return shape

for i,s in enumerate(PARTS):
    f=doc.addObject('Part::Feature', 'S'+str(i+1).zfill(3))
    f.Label=s.name
    f.Shape=make_feature(s)
    ev=EXPLOSION_VECTORS.get(i+1,(0,0,0))
    f.addProperty('App::PropertyVector','ExplosionVector','SmartSort','Original-to-exploded display offset in millimetres')
    f.ExplosionVector=Vector(*ev)
    f.Placement.Base=Vector(*(v*EXPLOSION_FACTOR for v in ev))
    f.addProperty('App::PropertyString','Function','SmartSort');f.Function=s.role
    f.addProperty('App::PropertyString','MaterialNote','SmartSort');f.MaterialNote=s.material
    f.addProperty('App::PropertyString','AssemblyGroup','SmartSort');f.AssemblyGroup=s.group
    f.ViewObject.ShapeColor=s.color
    f.ViewObject.DisplayMode='Flat Lines'
    f.ViewObject.Transparency=s.transparency
    folders[s.group].addObject(f)

doc.recompute()
if App.GuiUp:
    import FreeCADGui as Gui
    Gui.activeDocument().activeView().viewAxonometric()
    Gui.activeDocument().activeView().fitAll()
output_dir=os.path.join(os.path.expanduser('~'),'Documents')
os.makedirs(output_dir,exist_ok=True)
output_file=os.path.join(output_dir,'SmartSort_AI_Exploded_v2.FCStd')
doc.saveAs(output_file)
print('FreeCAD file written to:',output_file)
print('SmartSort: ',len(PARTS),'separate components created. Review the model and save the document.')
